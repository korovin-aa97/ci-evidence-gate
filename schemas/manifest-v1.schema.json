{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/korovin-aa97/ci-evidence-gate/v0.1.0/schemas/manifest-v1.schema.json",
  "title": "Decoded CI Evidence Gate manifest v1",
  "description": "JSON Schema for the data model obtained after decoding ci-evidence TOML.",
  "type": "object",
  "required": ["schema", "policy", "checks", "surfaces"],
  "properties": {
    "schema": {"const": "ci-evidence-manifest/v1"},
    "policy": {
      "type": "object",
      "required": ["protected"],
      "properties": {
        "max_evidence_age_hours": {"type": "integer", "minimum": 1, "maximum": 720},
        "protected": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "workflow"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
          "app_slug": {"type": "string", "minLength": 1},
          "allowed_conclusions": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["success", "neutral"]}
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["pull_request", "pull_request_target", "merge_group", "push"]}
          },
          "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 720}
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "patterns", "checks"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
